{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tk1142548/flow-aware-campus-rag-prototype/blob/main/data/schemas/evaluation-plan.schema.json",
  "title": "阶段 2 冻结评测规划",
  "description": "用于冻结 Q-003 确认的事项范围、200 个样本槽位、分层配额、复核比例和版本规则。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "decision_id",
    "status",
    "confirmed_on",
    "dataset_id",
    "dataset_release_version",
    "formal_items",
    "transfer_candidates",
    "target_sample_count",
    "allocation",
    "review_policy",
    "freeze_policy",
    "upstream_baseline",
    "content_artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plan_id": {
      "const": "STAGE2_EVAL_200_V1"
    },
    "decision_id": {
      "const": "D-017"
    },
    "status": {
      "enum": [
        "allocation_frozen",
        "content_frozen"
      ]
    },
    "confirmed_on": {
      "const": "2026-07-30"
    },
    "dataset_id": {
      "const": "CAMPUS_RAG_STAGE2_EVAL"
    },
    "dataset_release_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
    },
    "formal_items": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/formalItem"
      }
    },
    "transfer_candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/transferCandidate"
      }
    },
    "target_sample_count": {
      "const": 200
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_path",
        "blueprint_sha256",
        "per_item",
        "scenario_type",
        "difficulty",
        "version_risk",
        "turn_structure"
      ],
      "properties": {
        "blueprint_path": {
          "const": "data/research/stage2-evaluation-blueprint.csv"
        },
        "blueprint_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "per_item": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "UG_PROOF_PRINT",
            "UG_STATUS_CHANGE",
            "UG_WITHDRAWAL",
            "UG_CREDENTIAL_REISSUE",
            "UG_STUDENT_CARD_REISSUE",
            "UG_COURSE_SELECTION",
            "UG_LEAVE_REQUEST",
            "UG_MAJOR_CHANGE"
          ],
          "properties": {
            "UG_PROOF_PRINT": {
              "const": 25
            },
            "UG_STATUS_CHANGE": {
              "const": 25
            },
            "UG_WITHDRAWAL": {
              "const": 25
            },
            "UG_CREDENTIAL_REISSUE": {
              "const": 25
            },
            "UG_STUDENT_CARD_REISSUE": {
              "const": 25
            },
            "UG_COURSE_SELECTION": {
              "const": 25
            },
            "UG_LEAVE_REQUEST": {
              "const": 25
            },
            "UG_MAJOR_CHANGE": {
              "const": 25
            }
          }
        },
        "scenario_type": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direct",
            "condition_missing",
            "object_mismatch",
            "version_conflict",
            "step_error",
            "material_confusion",
            "out_of_scope",
            "multi_turn"
          ],
          "properties": {
            "direct": {
              "const": 32
            },
            "condition_missing": {
              "const": 32
            },
            "object_mismatch": {
              "const": 24
            },
            "version_conflict": {
              "const": 24
            },
            "step_error": {
              "const": 24
            },
            "material_confusion": {
              "const": 24
            },
            "out_of_scope": {
              "const": 16
            },
            "multi_turn": {
              "const": 24
            }
          }
        },
        "difficulty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "easy",
            "medium",
            "hard"
          ],
          "properties": {
            "easy": {
              "const": 48
            },
            "medium": {
              "const": 96
            },
            "hard": {
              "const": 56
            }
          }
        },
        "version_risk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stable",
            "version_sensitive",
            "cross_version_conflict"
          ],
          "properties": {
            "stable": {
              "const": 104
            },
            "version_sensitive": {
              "const": 72
            },
            "cross_version_conflict": {
              "const": 24
            }
          }
        },
        "turn_structure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "single_turn",
            "multi_turn"
          ],
          "properties": {
            "single_turn": {
              "const": 176
            },
            "multi_turn": {
              "const": 24
            }
          }
        }
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_reviews_per_sample",
        "independent_second_reviews_per_sample",
        "second_review_coverage",
        "reviewer_identity_must_differ",
        "disagreements_require_adjudication",
        "unresolved_disagreements_allowed_at_freeze",
        "review_dimensions"
      ],
      "properties": {
        "primary_reviews_per_sample": {
          "const": 1
        },
        "independent_second_reviews_per_sample": {
          "const": 1
        },
        "second_review_coverage": {
          "const": 1.0
        },
        "reviewer_identity_must_differ": {
          "const": true
        },
        "disagreements_require_adjudication": {
          "const": true
        },
        "unresolved_disagreements_allowed_at_freeze": {
          "const": false
        },
        "review_dimensions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "item_mapping",
              "slot_and_follow_up",
              "process_structure",
              "claim_and_evidence",
              "version_applicability",
              "leakage_control"
            ]
          }
        }
      }
    },
    "freeze_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocation_frozen_at",
        "content_freeze_status",
        "content_freeze_version",
        "sample_id_rule",
        "version_rule",
        "content_freeze_gate",
        "immutable_after_content_freeze",
        "method_tuning_boundary",
        "hash_algorithm"
      ],
      "properties": {
        "allocation_frozen_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_freeze_status": {
          "enum": [
            "pending",
            "frozen"
          ]
        },
        "content_freeze_version": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
        },
        "sample_id_rule": {
          "type": "string",
          "minLength": 1
        },
        "version_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "major",
            "minor",
            "patch"
          ],
          "properties": {
            "major": {
              "type": "string",
              "minLength": 1
            },
            "minor": {
              "type": "string",
              "minLength": 1
            },
            "patch": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "content_freeze_gate": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "immutable_after_content_freeze": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "method_tuning_boundary": {
          "type": "string",
          "minLength": 1
        },
        "hash_algorithm": {
          "const": "sha256"
        },
        "content_frozen_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "upstream_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage1_data_commit",
        "source_records_path",
        "source_records_sha256",
        "evidence_units_path",
        "evidence_units_sha256",
        "candidate_survey_path",
        "candidate_survey_sha256"
      ],
      "properties": {
        "stage1_data_commit": {
          "const": "cb243dd46b04e4ab113bdaf754894482af999ff6"
        },
        "source_records_path": {
          "const": "data/research/source_records.jsonl"
        },
        "source_records_sha256": {
          "const": "dbe4d81ef96bd2ae8707f83206f813fb39720bc70f0eb7d404e2892d271b415c"
        },
        "evidence_units_path": {
          "const": "data/research/evidence_units.jsonl"
        },
        "evidence_units_sha256": {
          "const": "8ccf3e5783b6bdea345fc077a7c33b10ce5ad8815c9886aa0a415ce6f33e7c0a"
        },
        "candidate_survey_path": {
          "const": "data/research/candidate-item-survey.csv"
        },
        "candidate_survey_sha256": {
          "const": "c88cb1ad8c4be41abfed293dd97449bd389ff6b532b6266cc5e1cdb1de45e8e7"
        }
      }
    },
    "content_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samples_path",
        "samples_sha256",
        "reviews_path",
        "reviews_sha256",
        "leakage_report_path",
        "leakage_report_sha256"
      ],
      "properties": {
        "samples_path": {
          "type": "string",
          "minLength": 1
        },
        "samples_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviews_path": {
          "type": "string",
          "minLength": 1
        },
        "reviews_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "leakage_report_path": {
          "type": "string",
          "minLength": 1
        },
        "leakage_report_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "$defs": {
    "formalItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "item_code",
        "item_name",
        "sample_quota",
        "data_baseline_status"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "item_code": {
          "type": "string",
          "pattern": "^(PP|SC|WD|CR|SR|CS|LR|MC)$"
        },
        "item_name": {
          "type": "string",
          "minLength": 1
        },
        "sample_quota": {
          "const": 25
        },
        "data_baseline_status": {
          "enum": [
            "verified",
            "planned"
          ]
        }
      }
    },
    "transferCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "item_name",
        "admission_gate",
        "status"
      ],
      "properties": {
        "item_id": {
          "const": "UG_GRADUATION_INTERNSHIP"
        },
        "item_name": {
          "const": "毕业实习办理"
        },
        "admission_gate": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "planned"
        }
      }
    }
  }
}
